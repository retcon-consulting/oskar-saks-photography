generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  passwordHash       String
  role               String   @default("admin")
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
}

model Photo {
  id                 String   @id
  cloudinaryPublicId String   @unique
  url                String
  width              Int
  height             Int
  alt                String
  title              String?
  category           String
  cover              Boolean  @default(false)
  featured           Boolean  @default(false)
  tall               Boolean  @default(false)
  size               String   @default("medium")
  position           Int      @default(0)
  createdAt          DateTime @default(now())

  @@index([category, position])
}

model Category {
  slug        String @id
  heading     String
  tagline     String
  description String
}

// Single-row-per-key store for site-wide images (hero, about).
model SiteImage {
  key                String @id
  cloudinaryPublicId String
  url                String
  width              Int
  height             Int
  alt                String
  // Where the photo is anchored when the site crops it (object-position, 0-100). Null keeps the layout's default crop.
  focalX             Int?
  focalY             Int?
}

// Editable page copy, one row per page ("home", "about", "services"). `data` is validated by src/lib/contentSchema.ts;
// a missing or invalid row falls back to the defaults in that file.
model SiteContent {
  key  String @id
  data Json
}
